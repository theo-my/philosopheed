[{"doi":"10.1007/s10677-019-10037-3","title":"Moral Consistency Reasoning Reconsidered","authors":["Norbert Paulo"],"journal":"etmp","published":"2019-11-01","volume":"23","issue":"1","pages":"107-123","abstract":"Many contemporary ethicists use case-based reasoning to reach consistent beliefs about ethical matters. The idea is that particular cases elicit moral intuitions, which provide defeasible reasons to believe in their content. However, most proponents of case-based moral reasoning are not very explicit about how they resolve inconsistencies and how they abstract principles from judgments about particular cases. The aim of this article is to outline a methodology—called Consistency Reasoning Casuistry—for case-based reasoning in ethics. This methodology draws on Richmond Campbell and Victor Kumar’s naturalistic model for the resolution of inconsistencies between the content of intuitions about particular cases. I argue that reasons similar to those that motivate their model also support a more abstract form of moral reasoning that goes beyond mere resolutions of inconsistencies between case judgments and demands the formulation of more abstract moral norms. Consistency Reasoning Casuistry, it is argued, is a good candidate for a methodology for case-based moral reasoning that is in harmony with paradigms of contemporary moral psychology and that can accommodate the methodology implicit in the work of many contemporary ethicists.","topics":["ethics","metaphil","philsci"],"si":null,"url":"https://doi.org/10.1007/s10677-019-10037-3"},{"doi":"10.1007/s10677-019-10030-w","title":"Agency Laundering and Information Technologies","authors":["Alan Rubel","Clinton Castro","Adam Pham"],"journal":"etmp","published":"2019-08-01","volume":"22","issue":"4","pages":"1017-1041","abstract":"","topics":["action","ethics","tech-ai"],"si":null,"url":"https://doi.org/10.1007/s10677-019-10030-w"},{"doi":"10.1007/s10677-019-10029-3","title":"What’s Wrong with Designing People to Serve?","authors":["Bartek Chomanski"],"journal":"etmp","published":"2019-08-01","volume":"22","issue":"4","pages":"993-1015","abstract":"","topics":["ethics"],"si":null,"url":"https://doi.org/10.1007/s10677-019-10029-3"},{"doi":"10.1007/s10677-019-10016-8","title":"The Case for Emissions Egalitarianism","authors":["Olle Torpman"],"journal":"etmp","published":"2019-06-01","volume":"22","issue":"3","pages":"749-762","abstract":"","topics":["ethics","political"],"si":null,"url":"https://doi.org/10.1007/s10677-019-10016-8"},{"doi":"10.1007/s10677-019-10017-7","title":"The Impossibility of a Virtue Ethic","authors":["Loren E. Lomasky"],"journal":"etmp","published":"2019-06-01","volume":"22","issue":"3","pages":"685-700","abstract":"","topics":["ethics"],"si":null,"url":"https://doi.org/10.1007/s10677-019-10017-7"},{"doi":"10.1007/s10677-019-10007-9","title":"Responsibility for Killer Robots","authors":["Johannes Himmelreich"],"journal":"etmp","published":"2019-06-01","volume":"22","issue":"3","pages":"731-747","abstract":"","topics":["blame-resp","ethics","tech-ai"],"si":null,"url":"https://doi.org/10.1007/s10677-019-10007-9"},{"doi":"10.1007/s10677-019-10002-0","title":"What Is the Harm of Hate Speech?","authors":["Eric Barendt"],"journal":"etmp","published":"2019-05-25","volume":"22","issue":"3","pages":"539-553","abstract":"","topics":["ethics"],"si":null,"url":"https://doi.org/10.1007/s10677-019-10002-0"},{"doi":"10.1007/s10677-019-09996-4","title":"Understanding Harm and its Moral Significance","authors":["Matthew Hanser"],"journal":"etmp","published":"2019-05-22","volume":"22","issue":"4","pages":"853-870","abstract":"","topics":["epistemology","ethics"],"si":null,"url":"https://doi.org/10.1007/s10677-019-09996-4"},{"doi":"10.1007/s10677-019-09995-5","title":"Moral Disengagement and the Motivational Gap in Climate Change","authors":["Wouter Peeters","Lisa Diependaele","Sigrid Sterckx"],"journal":"etmp","published":"2019-04-01","volume":"22","issue":"2","pages":"425-4